{
  "name": "mockforge-studio",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Agree on the form before you build the product.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "ng serve --port 4300",
    "build": "ng build",
    "lint": "eslint src e2e",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "e2e": "playwright test",
    "extract-i18n": "node scripts/check-translations.mjs",
    "format": "prettier --write src e2e scripts/check-translations.mjs *.json *.js *.mjs *.ts .github/workflows/verify.yml",
    "format:check": "prettier --check src e2e scripts/check-translations.mjs *.json *.js *.mjs *.ts .github/workflows/verify.yml"
  },
  "dependencies": {
    "@angular/common": "~22.2.1",
    "@angular/compiler": "~22.2.1",
    "@angular/core": "~22.2.1",
    "@angular/forms": "~22.2.1",
    "@angular/platform-browser": "~22.2.1",
    "bootstrap": "~5.3.7",
    "rxjs": "~7.8.2",
    "tslib": "~2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.1",
    "@angular/platform-browser-dynamic": "~22.2.1",
    "@axe-core/playwright": "~4.12.1",
    "@playwright/test": "~1.61.1",
    "@types/bootstrap": "5.2.11",
    "@types/jest": "~30.0.0",
    "@types/node": "~22.13.9",
    "eslint": "~9.31.0",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "~30.5.2",
    "jest-preset-angular": "~17.0.1",
    "prettier": "3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.0"
  }
}
